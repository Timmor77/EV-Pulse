# --- Data Science & ML (CRITICAL FOR SIZE) ---
# Ignore raw and processed data (too large for Git)
data/raw/*
data/processed/*
data/external/*
notebooks/*
!data/raw/.gitkeep       # Trick: Keep empty directories
!data/processed/.gitkeep
!data/external/.gitkeep

# Trained models (often > 100MB)
# src/models/*.pkl
# src/models/*.joblib
# src/models/*.bin
# src/models/*.h5
# src/models/*.onnx

# Legacy v1 artifacts (kept locally only)
src/models/lgbm_model_v1.pkl
src/models/train_model_v1.py

# Notebook checkpoints
.ipynb_checkpoints

