# --- Data Science & ML (CRITIQUE POUR POIDS) ---
# On ignore les données brutes et processées (trop lourd pour Git)
data/raw/*
data/processed/*
data/external/*
notebooks/*
!data/raw/.gitkeep       # Astuce : On garde les dossiers vides
!data/processed/.gitkeep
!data/external/.gitkeep

